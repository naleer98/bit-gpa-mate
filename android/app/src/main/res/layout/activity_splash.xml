<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_background"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/splashCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/splash_card_background"
        android:elevation="16dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:contentDescription="@string/app_name"
            android:scaleType="centerInside"
            android:src="@drawable/uom_crest" />

        <TextView
            android:id="@+id/splashUniversity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:text="@string/splash_university"
            android:textColor="@color/brand_maroon"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/splashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="@string/splash_title"
            android:textColor="@color/ink"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/splashCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="@string/splash_caption"
            android:textColor="@color/muted"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="84dp"
            android:layout_height="4dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/divider_gradient" />

        <TextView
            android:id="@+id/splashDeveloper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:gravity="center"
            android:text="@string/developer_name"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/splashRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/developer_role"
            android:textColor="@color/brand_maroon"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
